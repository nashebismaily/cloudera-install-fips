#!/usr/bin/env bash
# Optional site/lab overrides. The top-level ../../EXPORTS remains primary.

export AUTO_TLS_CM_HOST='cm01.example.com'
# AUTO_TLS_HOSTS_CSV defaults to this utilities/tls/hosts.csv automatically.

# Production customer workflow:
# Inventory can be generated from MANAGER_HOST and AGENT_HOST when hosts.csv is absent.
export AUTO_TLS_AUTO_CREATE_HOSTS_CSV='true'
export AUTO_TLS_HOST_LIST="${MANAGER_HOST} ${AGENT_HOST}"
export AUTO_TLS_AUTO_DISCOVER_IP_SANS='true'

export AUTO_TLS_CERT_MODE='customer'
export AUTO_TLS_PREREQ_MODE='full'
export AUTO_TLS_DRY_RUN='true'

# Unencrypted PEM keys with protected PKCS12 keystore/truststore:
export AUTO_TLS_ENCRYPT_HOST_KEYS='false'
export AUTO_TLS_HOST_KEY_PASSWORD=''

# Password-protected PEM keys instead:
# export AUTO_TLS_ENCRYPT_HOST_KEYS='true'
# export AUTO_TLS_HOST_KEY_PASSWORD='ChangeMeHostKey12345'

# Existing administrative SSH access used once to create/distribute the
# dedicated autotls user/key. Default identities are tried automatically.
export AUTO_TLS_BOOTSTRAP_USER='root'
export AUTO_TLS_BOOTSTRAP_KEY_FILE=''
export AUTO_TLS_BOOTSTRAP_PASSWORD=''

# Internal lab test CA workflow:
# export AUTO_TLS_CERT_MODE='test'
# export AUTO_TLS_ALLOW_TEST_CA_ENABLE='true'
# export AUTO_TLS_DRY_RUN='true'

# To perform the live API call after a successful dry run:
# export AUTO_TLS_DRY_RUN='false'
# export AUTO_TLS_CONFIRM_LIVE='ENABLE-AUTOTLS'
