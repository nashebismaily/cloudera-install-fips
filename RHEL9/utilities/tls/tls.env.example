#!/usr/bin/env bash
# Optional TLS-only overrides. Edit this file, not just the terminal environment.
# RHEL9/EXPORTS remains the primary version/host/JDK/FIPS configuration.
export AUTO_TLS_CERT_MODE='customer'
export AUTO_TLS_DRY_RUN='true'
export AUTO_TLS_ALLOW_TEST_CA_ENABLE='false'
export AUTO_TLS_ENCRYPT_HOST_KEYS='true'
# Set actual API credentials and long, independent passwords in EXPORTS or here.
# export AUTO_TLS_CM_PASSWORD='ActualCMAccountPassword2026'
# export AUTO_TLS_HOST_KEY_PASSWORD='UniqueHostKeyPassword2026'
# export AUTO_TLS_KEYSTORE_PASSWORD='UniqueKeyStorePassword2026'
# export AUTO_TLS_TRUSTSTORE_PASSWORD='UniqueTrustStorePassword2026'
# Existing administrative access for one-time remote Auto-TLS SSH setup:
export AUTO_TLS_BOOTSTRAP_USER='root'
export AUTO_TLS_BOOTSTRAP_KEY_FILE=''
export AUTO_TLS_BOOTSTRAP_PASSWORD=''
# Unencrypted customer PEM keys are accepted only when this flag matches them:
# export AUTO_TLS_ENCRYPT_HOST_KEYS='false'
# export AUTO_TLS_HOST_KEY_PASSWORD=''
# After local validation, edit the following for live submission:
# export AUTO_TLS_DRY_RUN='false'
# export AUTO_TLS_CONFIRM_LIVE='ENABLE-AUTOTLS'
# After generateCmca completes, enable the separately guarded restart:
# export AUTO_TLS_CONFIRM_POST_RESTART='RESTART-AUTOTLS'
# export AUTO_TLS_AUTO_POST_RESTART='true'
